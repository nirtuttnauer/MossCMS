{
  "name": "moss-example-site",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
