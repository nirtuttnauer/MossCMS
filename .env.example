# Generate .env with scripts/configure.py; these placeholders must be replaced.
POSTGRES_DB=mosscms
POSTGRES_USER=mosscms
POSTGRES_PASSWORD=GENERATE_WITH_CONFIGURE_SCRIPT
MOSS_SECRET_KEY=GENERATE_WITH_CONFIGURE_SCRIPT
MOSS_SETUP_TOKEN=GENERATE_WITH_CONFIGURE_SCRIPT
MOSS_ENV=development
# true uses persistent SQLite and skips Postgres in Compose; false keeps Postgres.
MOSS_USE_SQLITE=false
# Temporary local development: true opens the admin without sign-in.
MOSS_SKIP_AUTH=false
MOSS_PUBLIC_URL=http://localhost:8001
MOSS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173,http://127.0.0.1:5173
MOSS_BIND_HOST=127.0.0.1
MOSS_PORT=8001
# Leave both unset to build mosscms:local from this checkout (pull_policy build).
# After an image is published, pin a tag or digest and pull it instead of building:
# MOSS_IMAGE=nirtuttnauer/mosscms:1.2.3
# MOSS_PULL_POLICY=missing
# Optional exact origins permitted to receive webhooks on private networks.
# For the Compose website: http://example-site:5174
MOSS_WEBHOOK_ORIGINS=
# Optional generic OIDC (Google, Microsoft, Keycloak, Authentik, etc.).
MOSS_OIDC_NAME=Single sign-on
MOSS_OIDC_DISCOVERY_URL=
MOSS_OIDC_CLIENT_ID=
MOSS_OIDC_CLIENT_SECRET=
# Optional GitHub OAuth.
MOSS_GITHUB_CLIENT_ID=
MOSS_GITHUB_CLIENT_SECRET=
# Optional S3-compatible asset storage. Default is the persistent local assets volume.
MOSS_S3_BUCKET=
MOSS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional OpenTelemetry: OTLP HTTP/protobuf base URL; no content/SQL text is exported.
MOSS_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=mosscms
MOSS_OTEL_TRACES_SAMPLE_RATE=0.1
OTEL_METRIC_EXPORT_INTERVAL=10000
